#!/usr/bin/env bash
# 星槎的日常操作入口。
#
# 存在的理由：正确的命令太长，而**长命令里每一段都是踩过的坑**——
#
#   docker compose -f deploy/linux/docker-compose.yml --env-file .env down \
#     && sudo rm -rf data && docker compose -f ... up -d --build
#
# 这一行有三个陷阱：① 容器还在跑的时候删 data，进程握着已删除的 inode 继续写，
# 表现是"我删了库，密码却还在"；② 删掉之后 Docker 会用 **root** 重建挂载点，
# 容器里 uid 10001 写不进去，直接进重启循环；③ 忘了 down 直接删，同 ①。
#
# 所以这里只暴露两个动作：
#
#   ./deploy/linux/xc start      —— 重新构建代码并起来，**data 一个字节都不动**
#   ./deploy/linux/xc redeploy   —— 连数据一起清空，从零开始（会问一次）
#
# 另外四个是顺手的：update / stop / logs / status。
#
# 这个脚本吸收了原来的 deploy.sh：那份脚本在 Caddy 去掉之后校验的还是已经不存在的
# XINGCHA_DOMAIN / ACME_EMAIL，也就是**坏的**；它唯一的独特价值是"新机器上拉代码"，
# 现在是这里的 update。

set -euo pipefail
# 脚本在 deploy/linux/ 下，而 .env 与 data/ 在仓库根。**从脚本自身的位置往上两级**，
# 这样它在任何目录下被调用都对（`deploy/linux/xc start`、`./deploy/linux/xc start`、绝对路径都行）。
#
# 两级不是一级：Windows 那条路（deploy/windows/xc.bat）与这条已经分成两个目录，
# 少数一级的话 compose 会在 deploy/ 下面建 data/，症状是"起来了但后台是空的"。
cd "$(dirname "$(dirname "$(dirname "$(readlink -f "$0")")")")"

# 契约里读一个值。用 sed 而不是 `grep -oP ... \K`：这台机器上 `grep` 是 ugrep
# 的 shim，PCRE 的 \K 不生效、返回 1，配上 set -e 就是**整个脚本静默退出**——
# 没有任何输出，看起来像脚本坏了。
from_contract() { sed -n "s/^$1[^=]*=[[:space:]]*\([0-9]\+\).*/\1/p" src/xingcha/contract/__init__.py | head -1; }
from_env()      { sed -n "s/^$1=\(.*\)/\1/p" .env 2>/dev/null | head -1; }

# 容器里的 UID。**从契约里读**，不写死——写死的那一刻它就会和 Dockerfile 漂移。
UID_IN_CONTAINER=$(from_contract CONTAINER_UID)
[ -n "$UID_IN_CONTAINER" ] || { echo "读不到 CONTAINER_UID（契约文件动过？）" >&2; exit 1; }
DATA_DIR=./data

# compose 文件与 .env 都显式传，**不依赖 COMPOSE_FILE 环境变量**：
# 那东西的分隔符跟着 os.pathsep 走（Linux `:`、Windows `;`），而且它意味着
# "在哪个目录下敲命令"会改变结果——正是上一版让人在 deploy/ 里 restart 失败的原因。
# 拓扑由 .env 里的 XINGCHA_GATEWAY 决定：
#   空（默认）  独立跑，发布一个宿主端口，明文 HTTP
#   有值        叠加 gateway 层：端口强制只绑 127.0.0.1，HTTPS 由本机那个 Caddy 终止
#
# 是文件而不是变量，因为那一层的两项（PUBLIC_URL / TRUSTED_PROXIES）**要么全有
# 要么全无**，而 ${} 表达不了"成套出现"——只改一项的后果是安静的。
GATEWAY=$(from_env XINGCHA_GATEWAY)
FILES=(-f deploy/linux/docker-compose.yml)
[ -n "$GATEWAY" ] && FILES+=(-f deploy/linux/docker-compose.gateway.yml)

# 绑定地址**是推出来的，不是用户变量**。两条规则，第一条优先：
#
#   配了网关                 → 127.0.0.1。网关是本机进程，走回环就够了；绑到
#                              局域网上等于在 TLS 旁边另开一条明文入口，
#                              而两条入口并存时人只会记住能打开的那一个。
#   没配网关，看 WEB_HOST    → localhost / 127.0.0.1 只绑回环；其它绑 0.0.0.0。
#
# 后一条合成到 XINGCHA_WEB_HOST 里，是因为分成两个变量最容易出的错是它们对不上：
# 页面上显示 192.168.1.10、实际只绑了回环，于是别人打不开而那个地址看起来完全正确。
#
# 为什么不直接绑那个 IP：更精确，但 DHCP 换一次地址容器就起不来
# （cannot assign requested address），而那个报错离"我改了个显示用的字段"很远。
derive_bind_addr() {
  [ -z "$GATEWAY" ] || { printf '127.0.0.1'; return; }
  case "$(from_env XINGCHA_WEB_HOST)" in
    "" | localhost | 127.0.0.1) printf '127.0.0.1' ;;
    *) printf '0.0.0.0' ;;
  esac
}
export XINGCHA_BIND_ADDR="$(derive_bind_addr)"

# 对外端口。**两种拓扑的来源不同，因为占端口的人不同。**
#
#   独立跑   这个容器自己发布，端口在本项目的 .env（XINGCHA_WEB_PORT）
#   走网关   端口是**网关**的，也就是 deploy/edge/Caddyfile 里那个 8443
#
# 走网关时写死 8443，而不是让用户在 .env 里再写一遍：写两遍就会不一致，而不一致的
# 症状是后台印出一个打不开的地址、服务本身却好着——最难认的那类。要换端口就
# Caddyfile 和这里一起改，两处都在版本控制里，而且有一条测试盯着它们相等。
#
# 也正因为来源不同，两种模式的端口**可以不一样**，于是网关常驻时切回独立模式
# 不会撞端口（网关 8443，独立默认 8720）。
public_port() {
  local p
  if [ -n "$GATEWAY" ]; then
    p=8443
  else
    p=$(from_env XINGCHA_WEB_PORT)
    [ -n "$p" ] || p=8720
  fi
  printf '%s' "$p"
}
export XINGCHA_PUBLIC_PORT="$(public_port)"

c() { docker compose "${FILES[@]}" --env-file .env "$@"; }

# 宿主端口。**两种拓扑都要查**：挂网关时容器照样发布 8720，只是绑在 127.0.0.1 上
# ——那也会跟别的占用者撞，而 docker 只会说 "port is already allocated"，
# 那句话既不告诉你占用者是谁，也不会指向 .env 里的哪一项。
#
# 网关自己用 8443，跟这个端口不冲突（它是宿主上的一个进程，见 require_gateway）。
require_free_port() {
  local port
  port=$(from_env XINGCHA_WEB_PORT); [ -n "$port" ] || port=8720
  ss -tln 2>/dev/null | grep -q ":$port " || return 0
  # 已经是我们自己占着就不算冲突（重启同一个容器）
  docker port xingcha-xingcha-1 2>/dev/null | grep -q ":$port\$" && return 0
  die "宿主端口 $port 已被占用。docker 只会说 port is already allocated，
  既不告诉你占用者是谁，也不会指向 .env 里的哪一项。看一眼：

    ss -tlnp | grep :$port

  多半是上一个还没停的容器（./deploy/linux/xc stop），或者别的项目占了这个端口
  （把 XINGCHA_WEB_PORT 换一个）。"
}

# 网关是**宿主上的一个进程**（Caddy 单文件），不是容器，所以判断依据是
# "$XINGCHA_PUBLIC_PORT 有没有人在听"，而不是查某个容器在不在。
#
# 认端口而不认进程名的理由：换成别的反代（nginx / Traefik）时这里不用跟着改，
# 而认名字的话换完之后检查仍然"通过"，实际却连不上。
require_gateway() {
  [ -n "$GATEWAY" ] || return 0
  ss -tln 2>/dev/null | grep -q ":$XINGCHA_PUBLIC_PORT " || die \
    "网关没在跑（没人听 $XINGCHA_PUBLIC_PORT）。先起它：

    ./deploy/edge/edge start

  没配好网关就起星槎的话，容器 healthy 而什么都打不开——那种状态最难认，
  因为每一层单独看都正常。不想要 HTTPS 就把 .env 里的 XINGCHA_GATEWAY 清空。"
  ok "网关就绪（127.0.0.1:$XINGCHA_PUBLIC_PORT）"
}

# up / down 一律带 --remove-orphans。
#
# 不带的话，**从 compose 里删掉一个服务之后它的容器会永远留着**：compose 只管
# 自己现在声明的服务，那个孤儿既不会被 down 掉，也不会被 up 重建，就一直跑着占端口。
# 实际踩过：Caddy 从编排里去掉之后，xingcha-caddy-1 还在跑、还占着 8443，
# 而 `docker compose ps` 看起来一切正常。
up()   { c up -d --build --remove-orphans "$@"; }
down() { c down --remove-orphans "$@"; }

die() { printf '\033[31m✗ %s\033[0m\n' "$*" >&2; exit 1; }
say() { printf '\033[36m→ %s\033[0m\n' "$*"; }
ok()  { printf '\033[32m✓ %s\033[0m\n' "$*"; }

# 缺什么就给出**可以直接粘贴执行**的安装命令。只说"缺少 docker"没有用。
need_docker() {
  command -v docker >/dev/null 2>&1 || die "缺 docker。安装：curl -fsSL https://get.docker.com | sh"
  docker compose version >/dev/null 2>&1 || die \
    "缺 docker compose v2（v1 的 docker-compose 已 EOL，不支持）。安装：sudo apt install docker-compose-plugin"
  docker info >/dev/null 2>&1 || die "docker 守护进程没在跑，或当前用户不在 docker 组。试：sudo usermod -aG docker $USER && newgrp docker"
}

need_env() {
  need_docker
  if [ ! -f .env ]; then
    say ".env 不存在，从模板生成一份"
    cp deploy/.env.example .env
    ok "已生成 .env"
    printf '  把 XINGCHA_WEB_HOST 填成这台机器的内网 IP，然后再跑一次。\n'
    printf '  想要 HTTPS：再加一行 XINGCHA_GATEWAY=edge，然后 ./deploy/edge/edge start。\n'
    exit 0
  fi
}

# data 目录必须存在、且属于容器里的那个 UID。
#
# 这一步是整个脚本存在的主要理由：Docker 在挂载点不存在时会用 root 创建它，
# 而星槎以非 root 运行——于是首次部署、以及每一次"删了 data 重来"都会撞上
# PermissionError，而症状只是容器无限重启。
ensure_data_owner() {
  mkdir -p "$DATA_DIR"
  local owner
  owner=$(stat -c '%u' "$DATA_DIR")
  if [ "$owner" != "$UID_IN_CONTAINER" ]; then
    say "data 目录属主是 UID $owner，容器里需要 $UID_IN_CONTAINER —— 用 sudo 改一次"
    sudo chown -R "$UID_IN_CONTAINER:$UID_IN_CONTAINER" "$DATA_DIR"
    sudo chmod 700 "$DATA_DIR"
  fi
  ok "data 目录就绪（属主 $UID_IN_CONTAINER，权限 700）"
}

wait_healthy() {
  local name; name=$(c ps -q xingcha)
  [ -n "$name" ] || die "xingcha 容器没起来。看 ./deploy/linux/xc logs"
  say "等健康检查…"
  for _ in $(seq 1 60); do
    case "$(docker inspect -f '{{.State.Health.Status}}' "$name" 2>/dev/null)" in
      healthy) ok "healthy"; return 0 ;;
      # 起不来的时候**立刻把日志摊开**，而不是让人等满 60 次再自己去找
      *) [ "$(docker inspect -f '{{.State.Restarting}}' "$name")" = true ] && {
           printf '\n'; c logs --tail 20 xingcha; die "容器在重启循环里（日志见上）"; } ;;
    esac
    sleep 2
  done
  printf '\n'; c logs --tail 30 xingcha
  die "两分钟没等到 healthy（日志见上）"
}

# XINGCHA_WEB_HOST 只用于**显示**。填 0.0.0.0 / :: 是把监听地址错填到了这里——
# 那两个是"绑在所有接口上"的意思，不是能在浏览器里敲的主机名。
# 不静默接受：打印一个 https://0.0.0.0:8443 出来，人照着敲必然失败。
display_host() {
  local h
  h=$(from_env XINGCHA_WEB_HOST)
  case "$h" in
    "" | 0.0.0.0 | ::| "[::]")
      local guess
      guess=$(ip route get 1.1.1.1 2>/dev/null | sed -n 's/.* src \([0-9.]*\).*/\1/p' | head -1)
      [ -n "$guess" ] || guess=localhost
      [ -n "$h" ] && warn "XINGCHA_WEB_HOST=$h 是监听地址，不是能敲的主机名。下面按本机 IP 显示；请在 .env 里改成 $guess。"
      printf '%s' "$guess"
      ;;
    *) printf '%s' "$h" ;;
  esac
}

show_url() {
  local host port
  host=$(display_host)

  port="$XINGCHA_PUBLIC_PORT"

  if [ -n "$GATEWAY" ]; then
    printf '\n\033[1m  https://%s:%s\033[0m\n' "$host" "$port"
    printf '  经本机网关（deploy/edge）。容器那个端口只绑 127.0.0.1，没有别的入口。\n'
    printf '  浏览器还拦的话，是这台设备还没装根证书：./deploy/edge/edge trust\n\n'
    return
  fi

  printf '\n\033[1m  http://%s:%s\033[0m\n' "$host" "$port"
  printf '  **明文 HTTP**：密码与 sk-xc- 密钥在网络上是裸传的。\n'
  if [ "$XINGCHA_BIND_ADDR" = 127.0.0.1 ]; then
    printf '  只绑在回环上，别的设备访问不到。要开给局域网：把 XINGCHA_WEB_HOST 填成内网 IP\n'
    printf '  （那个端口走 DOCKER-USER 链，会绕过 ufw。）\n'
  fi
  printf '  想要 HTTPS：./deploy/edge/edge start，再在 .env 里写 XINGCHA_GATEWAY=edge。\n\n'
}

case "${1:-}" in
  start)
    need_env; require_gateway; require_free_port; ensure_data_owner
    say "构建并启动（保留 data）"
    up
    wait_healthy; show_url
    ;;

  redeploy)
    need_env
    printf '\033[33m这会删掉 %s 里的全部数据：数据库、密钥环、备份。\033[0m\n' "$DATA_DIR"
    printf '上游 key、后台密码、所有 Agent 与调用记录都会没有。输入 yes 继续：'
    read -r answer
    [ "$answer" = yes ] || die "已取消，什么都没动。"

    # **先 down 再删**。反过来的话进程还握着已删除的 inode 继续写，
    # 表现为"我删了库，密码却还在"——这一条是实际踩出来的。
    say "停止容器"
    down
    say "删除 $DATA_DIR"
    sudo rm -rf "$DATA_DIR"
    ensure_data_owner
    say "构建并启动"
    up
    wait_healthy
    ok "全新实例。第一次打开 /admin 会引导设定密码（或按 .env 里的 XINGCHA_ADMIN_PASSWORD）"
    show_url
    ;;

  update)
    need_env; require_gateway
    # `pull --ff-only` 而不是 `reset --hard`。
    #
    # 原来的 deploy.sh 用的是 reset --hard，理由是"部署机以远程为准"。但这个脚本
    # 同样会在**开发机**上被跑，而那里 reset --hard 会不声不响地毁掉未提交的工作。
    # 所以改成：脏工作区直接拒绝，让人自己决定怎么处理。
    git diff --quiet && git diff --cached --quiet \
      || die "工作区有未提交的改动。先 commit 或 stash，再 update。"
    say "拉代码"
    git pull --ff-only
    say "构建并启动"
    ensure_data_owner
    up
    wait_healthy; show_url
    ;;

  stop)   down; ok "已停止（data 保留）" ;;
  logs)   shift; c logs -f --tail "${1:-50}" xingcha ;;
  status)
    c ps
    printf '\n'; c exec -T xingcha xingcha admin status 2>/dev/null || true
    ;;

  *)
    cat <<'EOF'
星槎

  ./deploy/linux/xc start        重新构建代码并启动，data 不动（日常用这个）
  ./deploy/linux/xc update       拉代码 + 重新构建启动（工作区脏时会拒绝）
  ./deploy/linux/xc redeploy     清空 data 从零开始（会问一次 yes）
  ./deploy/linux/xc stop         停止，data 保留
  ./deploy/linux/xc logs [n]     跟随日志
  ./deploy/linux/xc status       容器状态 + 后台账号状态
EOF
    exit 1
    ;;
esac
