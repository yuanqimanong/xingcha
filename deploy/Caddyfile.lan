# 局域网 / 本机测试用的 Caddy 配置。
#
# 与生产的 ../Caddyfile 只差两处：
#   1. 证书走 Caddy 的**内部 CA**（`tls internal`）而不是 ACME —— 局域网 IP 与
#      localhost 拿不到公网证书。浏览器会报不受信任，点继续即可。
#   2. 端口默认 8443，不占宿主的 80/443。
#
# 为什么局域网也非要 HTTPS：后台的会话 cookie 是 secure=True（生产永远在 TLS
# 后面）。明文 HTTP 下浏览器会拒绝存它，症状是"登录返回 303 又被弹回登录页"的
# 死循环——一个完全看不出原因的现象。
{
	auto_https disable_redirects
}

# ------------------------------------------------------------------------------
# 站点地址只写端口，不写主机名
# ------------------------------------------------------------------------------
#
# 写成 `https://192.168.183.132:8443` 会撞上 IP 证书的一个固有限制：**SNI 里不允许
# 放 IP**（RFC 6066）。于是 curl 一类客户端发出的 SNI 与站点地址对不上，Caddy 直接
# 拒绝握手（`TLS alert internal error`）——而证书本身是对的，SAN 里确实有那个 IP。
# 实测踩过：openssl（不发 SNI 时）能连，curl 不能，差别就在这里。
#
# 只写 `:8443` 让这个站点**不按主机名匹配**，IP、localhost、127.0.0.1 都能进来。
:{$XINGCHA_LAN_PORT:8443} {
	# `on_demand` 是必需的，不是偷懒：站点地址没有主机名，Caddy 就没有可预签的
	# 名字，不按需签发的话它手上一张证书都没有，握手直接失败（实测：不加这一行
	# 三个地址全部连不上）。
	#
	# Caddy 会为此警告 "YOUR SERVER MAY BE VULNERABLE TO ABUSE"。在这里可以接受，
	# 而且**只在这里**：
	#   · 签发方是**本地 CA**，不是公网 ACME —— 签多少张都不消耗任何配额、
	#     也不会被别人当成可信证书；
	#   · 这份配置只用于局域网/本机测试，生产走 ../Caddyfile 的 ACME 那条路，
	#     那边有明确的域名、不开 on_demand。
	#
	# 换来的是**只有一次浏览器警告**（CA 不受信任）。改成显式列 localhost 的话，
	# 用 IP 访问会额外多一次"证书名不匹配"的警告——同样要点继续，但更劝退。
	tls internal {
		on_demand
	}

	request_body {
		max_size 10MB
	}

	header {
		X-Content-Type-Options "nosniff"
		Referrer-Policy "same-origin"
		-Server
	}

	# compose 网络里按服务名寻址，所以 xingcha 容器**不需要**发布任何宿主端口——
	# 与生产形状一致。
	reverse_proxy xingcha:8720 {
		header_up X-Real-IP {remote_host}
		transport http {
			read_timeout 900s
			write_timeout 900s
		}
		flush_interval -1
	}
}
