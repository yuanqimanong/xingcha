# 星槎部署配置
#
#     cp deploy/.env.example .env        # 复制到**仓库根**，不是 deploy/ 下
#     ./deploy/linux/xc start
#
# **一项都不改也能起来**：非敏感项都有默认值，key 与密码留空表示"登录后再加"。
#
# Windows 双击 deploy\windows\xc.bat 会替你生成这份 .env。**那条路径不走 docker**，
# 所以 GATEWAY / WEB_PORT / DATA_MOUNT 对它无效（那几项是给 compose 看的），要改的
# 在最后一节。例外是 XINGCHA_WEB_HOST——网关两条路都用它，那是证书上的名字。


# ═══════════════════════════════════════════════════════════════════════════
# 1 · 怎么访问它
# ═══════════════════════════════════════════════════════════════════════════

# 前面有没有那个网关（deploy/edge/ 里的 Caddy 单文件）。**这是 http / https 的开关。**
#
#   留空    明文 HTTP，容器发布的那个端口就是入口
#   edge    入口是 https://<WEB_HOST>:8443；容器那个端口被强制**只绑 127.0.0.1**
#
# 值是网关那个目录的名字，不是地址——网关是宿主上的一个进程，不是容器。
# deploy/linux/xc 读它决定叠不叠 docker-compose.gateway.yml，并只在配了它时检查
# 网关在不在。网关怎么起见 deploy/README.md；没装 docker 的机器看第 4 节。
XINGCHA_GATEWAY=

# 你在浏览器里敲的主机名或 IP。
#
# ┌─ 注意：它和第 4 节的 XINGCHA_HOST 不是一回事 ────────────────────────────┐
# │                                                                          │
# │   XINGCHA_WEB_HOST  编排层的变量。**应用根本不读它**（当未知项忽略）。    │
# │                     用它的是：网关签证书的名字与 default_sni、compose    │
# │                     发布端口绑哪儿、后台页面上展示的地址。               │
# │                                                                          │
# │   XINGCHA_HOST      应用自己 bind() 的地址（第 4 节）。默认 127.0.0.1。  │
# │                                                                          │
# │ 名字像、作用不像。想"让别的机器能访问"而只改了 WEB_HOST 的话：docker 那  │
# │ 条路有效（xc 会据此推出发布地址），**uv 直跑那条路是个静默空操作**——     │
# │ 应用照旧绑回环，而页面上印的地址看起来完全正确。                         │
# └──────────────────────────────────────────────────────────────────────────┘
#
#   localhost / 127.0.0.1   只有这台机器能访问（默认）
#   内网 IP 或域名           别人也能访问（docker 路：据此绑 0.0.0.0）
#   0.0.0.0 或留空           **网关脚本会自动探测本机内网 IP**，不用写死
#
# 自动探测那一条是后加的：证书签不给 0.0.0.0（那是监听地址，不是能敲的名字），
# 而写死 IP 的话 DHCP 换一次地址就"证书警告点不过去"，`.env` 看起来却完全正常。
# 取有默认网关、网卡 Up 的那一张，跳过 VMware / VirtualBox / WSL 的虚拟网卡。
#
# 挂网关时它不影响绑定（那时一律绑 127.0.0.1，见 xc 的 derive_bind_addr）。
# 开给局域网这件事本身要想清楚：映射出去的端口走 DOCKER-USER 链，**会绕过 ufw**。
XINGCHA_WEB_HOST=localhost

# 容器发布的宿主端口。挂网关时你在浏览器里敲的是网关的 8443（那个数字在
# deploy/edge/Caddyfile 里，xc 自己知道，不在这里再写一遍）。
#
# **改了这一项就要同步改 Caddyfile 里的 reverse_proxy 端口**，否则网关回 502
# 而星槎自己完全健康。
XINGCHA_WEB_PORT=8720


# ═══════════════════════════════════════════════════════════════════════════
# 2 · 凭据（敏感项一律无默认值；空 = 没设置）
# ═══════════════════════════════════════════════════════════════════════════

# 后台密码。留空 = 第一次打开 /admin 时引导你设一个（推荐）。
# 填了就按它登录，任意长度都生效（太短会在启动日志里警告一次）。两件事要知道：
#   · 它会出现在 docker inspect 与 /proc/<pid>/environ 里；
#   · **先立者为准** —— 一旦你在页面上设过密码，这一项就永久不生效了。
XINGCHA_ADMIN_PASSWORD=

# 默认上游。不填就登录后到「上游」页配。BASE_URL 不填时回落到 OpenRouter。
# key 只在首次启动时被加密导入数据库，之后永久忽略——配好之后建议从这里删掉。
XINGCHA_API_KEY=
XINGCHA_BASE_URL=

# 各厂商的 key（可选，写几个都行）。后台「上游」页会扫出来，一键切换。
# 内置名单 30 个，大小写不敏感。写完要重启——环境变量在进程启动时读取。
#
# **同名的真实环境变量会压住这里写的。** 启动时只把这里有、而环境里没有的补进去
# （真实环境变量优先是配置系统的共识；反过来的话想临时换一把 key 就得改文件，
# 而改完很容易忘了改回去）。
#
# 这一条踩过：shell 里留着一把过期的 DEEPSEEK_API_KEY，上游页扫出来的是那一把，
# 页面上看着配好了、点切换却 401，而这里写的明明是好的——**两把同名，页面上分不出
# 哪把在起作用**。启动日志会印一行"已从 .env 读入厂商 key：…"，没印到你想要的那个
# 名字，就说明环境里已经有同名的了。清掉它：
#
#     PowerShell   Remove-Item Env:DEEPSEEK_API_KEY
#     bash         unset DEEPSEEK_API_KEY
#
# DEEPSEEK_API_KEY=
# DASHSCOPE_API_KEY=
# MOONSHOT_API_KEY=
# GEMINI_API_KEY=
# OPENAI_API_KEY=

# 出站代理。上游按**出口 IP 的区域**拒绝请求时要用——OpenRouter 对 OpenAI 与
# Google 的模型会回 "This model is not available in your region."，而机器上那个
# 已经配好的代理正是唯一能用的出口。
#
# **必须写在这里，不能只在宿主 shell 里 export。** compose 只把这个文件注进容器
# （docker-compose.yml 的 env_file），你在宿主上 export 的那几个变量容器完全看不见，
# 于是代码里 trust_env=True 读到的是一份空环境，读了也白读。
#
# **用 http 代理，不要 socks。** 镜像里没有 socksio，ALL_PROXY=socks5://… 会让客户端
# 在构造阶段直接 ImportError；代码兜住了（退回直连并警告），但那样代理等于没配。
# 大多数本地代理软件的 http 端口和 socks 端口是同一个软件的两个入口，换个端口就行。
#
# **NO_PROXY 那行不能省。** 容器的健康检查是 curl 127.0.0.1:8720/healthz，curl 也读
# 这几个变量——不排除回环的话健康检查会往代理上送，容器一直 unhealthy，
# 而日志里什么异常都没有。
#
# 宿主上的代理对容器而言不是 127.0.0.1。Docker Desktop（Win/Mac）用
# host.docker.internal；Linux 用 172.17.0.1，或给容器加 network_mode: host。
#
# HTTP_PROXY=http://host.docker.internal:7890
# HTTPS_PROXY=http://host.docker.internal:7890
# NO_PROXY=127.0.0.1,localhost,::1


# ═══════════════════════════════════════════════════════════════════════════
# 3 · 其它（都有能用的默认值，一般不动）
# ═══════════════════════════════════════════════════════════════════════════

XINGCHA_LOG_LEVEL=INFO

# 数据挂载点。默认 ../data（仓库根下的 data/），填卷名则改用命名卷。
# 只在宿主目录不适合放 SQLite 时才动——网络文件系统上 WAL 会静默降级，症状是
# 零星的 database is locked，只在并发写时出现。**本地磁盘不要改。**
# XINGCHA_DATA_MOUNT=xingcha_data

# 更细的调参（并发上限、超时、限流、目录 TTL……）见仓库根 README 的「对外契约」。


# ═══════════════════════════════════════════════════════════════════════════
# 4 · 不走 docker 的那条路（Windows 双击 xc.bat；Linux 上 uv 直接跑）
# ═══════════════════════════════════════════════════════════════════════════
#
# **这一节以前有四项要你填，现在一项都不用。**
#
# 应用真正读的是 XINGCHA_HOST / XINGCHA_PORT / XINGCHA_PUBLIC_URL /
# XINGCHA_TRUSTED_PROXIES，它们全部由第 1 节那三项推出来：
#
#   挂网关（XINGCHA_GATEWAY=edge）
#       绑 127.0.0.1          网关是本机进程，走回环就够了；绑到局域网上等于在
#                             TLS 旁边另开一条明文入口
#       入口 https://<WEB_HOST>:8443        端口是**网关的**，来自 edge/Caddyfile
#       信任 127.0.0.1 的 X-Forwarded-*     不信的话应用以为自己在 http 上，
#                                           会话 cookie 不带 Secure——功能完全
#                                           正常，只是少一层保护，没人会注意到
#
#   不挂网关
#       WEB_HOST 是 localhost/127.0.0.1 → 绑回环；其它 → 绑 0.0.0.0
#       入口 http://<WEB_HOST>:<WEB_PORT>，不信任任何反代
#
# 推导写在 deploy/_common.ps1（Windows）与 deploy/linux/xc（docker），两处规则
# 逐条对齐——不然"我在 Windows 上跑的和 Linux 上不是一个东西"。
#
# 为什么不让你自己填（以前就是）：
#   · XINGCHA_WEB_HOST 与 XINGCHA_HOST 名字像、作用完全不同（**应用根本不读前者**），
#     想"让别人能访问"而只改了前者，是个静默空操作；
#   · "挂了网关"这件事要在四个地方分别表达一遍，只改一处的后果同样安静。
#
# 真要覆盖（比如换个端口避让别的服务），把对应的 XINGCHA_* 写在这里即可——
# 真实环境变量优先于推导值。但先想清楚为什么推出来的那个不对。
