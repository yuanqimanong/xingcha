# 星槎部署配置。复制到**仓库根**的 .env（不是 deploy/.env）：
#
#     cp deploy/.env.example .env
#
# 然后 ./deploy/xc start。

# ---------------------------------------------------------------------------
# 访问
# ---------------------------------------------------------------------------

# 宿主上绑哪个地址。**默认只绑回环**，也就是只有这台机器能访问。
#
# 要开给局域网就写 0.0.0.0。这必须是一次显式选择：映射出去的端口走 Docker 的
# DOCKER-USER 链，**会绕过 ufw**——你在防火墙里写的 deny 对它无效。
XINGCHA_BIND_ADDR=127.0.0.1

# 宿主端口。
XINGCHA_WEB_PORT=8720

# 你在浏览器里敲的主机名或 IP。只用来生成后台里展示的 curl 示例，不影响监听。
XINGCHA_WEB_HOST=localhost

# ---------------------------------------------------------------------------
# 后台密码
# ---------------------------------------------------------------------------

# 留空 = 没设置：第一次打开 /admin 会引导你设一个（推荐）。
#
# 填了就按它登录，任意长度都生效（太短会在启动日志里警告一次）。
# 注意两件事：
#   · 它会出现在 docker inspect 与 /proc/<pid>/environ 里；
#   · **先立者为准**——一旦你在页面上设过密码，这一项就永久不生效了。
XINGCHA_ADMIN_PASSWORD=

# ---------------------------------------------------------------------------
# 上游
# ---------------------------------------------------------------------------

# 默认出口。不填的话首次启动后去后台的「上游」页配。
#
# 后台还会自动发现这台机器上的厂商 key 变量（DEEPSEEK_API_KEY、
# DASHSCOPE_API_KEY、MOONSHOT_API_KEY……），在上游页一键切换。
# 变量名大小写不敏感。
XINGCHA_API_KEY=
XINGCHA_BASE_URL=

# ---------------------------------------------------------------------------
# 其它
# ---------------------------------------------------------------------------

XINGCHA_LOG_LEVEL=INFO

# 数据挂载点。默认 ../data（仓库根下的 data/）。
#
# **Windows 必须改成命名卷**：`XINGCHA_DATA_MOUNT=xingcha_data`。
# Docker Desktop 经 9p/virtiofs 把 Windows 目录挂进虚拟机，那是网络文件系统，
# SQLite 的 WAL 在上面会静默降级——症状是零星的 database is locked。
# XINGCHA_DATA_MOUNT=xingcha_data
