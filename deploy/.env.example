# 星槎部署配置
#
# 复制到**仓库根**（不是 deploy/ 下）：
#
#     cp deploy/.env.example .env
#
# 然后 ./deploy/xc start。**一项都不改也能起来**——非敏感项都有默认值，
# key 与密码留空表示"登录后再加"。
#
# 下面按"多半要动 → 可能要动 → 几乎不动"排。


# ═══════════════════════════════════════════════════════════════════════════
# 1 · 怎么访问它
# ═══════════════════════════════════════════════════════════════════════════

# 走不走共享网关（那台 Caddy）。**这是 http / https 的开关。**
#
#   留空    明文 HTTP，这个容器自己发布端口
#   edge    加入那个 docker 网络，零宿主端口，对外 HTTPS 由网关提供
#
# 值是 **docker 网络名**，不是地址。网关是一个独立项目（与 xingcha 平行的 edge/），
# 一台 Caddy 可以同时服务本机多个项目——根证书在每台设备只装一次。
# 怎么起、怎么装根证书：deploy/CADDY.md
XINGCHA_GATEWAY=

# 你在浏览器里敲的主机名或 IP。**它同时决定绑在哪个接口上**：
#
#   localhost / 127.0.0.1   只绑回环，只有这台机器能访问（默认，安全的那一档）
#   其它（IP 或域名）         绑 0.0.0.0，局域网可访问
#
# 合成一个变量，是因为分成两个最容易出的错是二者对不上：显示 192.168.1.10、
# 却只绑了回环，于是别人打不开而页面上的地址看起来完全正确。
#
# **不要填 0.0.0.0** —— 那是"绑在所有接口上"的意思，不是能敲的名字。填了的话后台
# 会印出一条 http://0.0.0.0:8720/v1 的命令，照着敲必然失败。
#
# 开给局域网这件事本身要想清楚：映射出去的端口走 Docker 的 DOCKER-USER 链，
# **会绕过 ufw**。
XINGCHA_WEB_HOST=localhost

# 端口，**只在不走网关时用**。
#
# 走网关时端口是网关的，源头在 edge/.env 的 PORT_XINGCHA，deploy/xc 去那儿读——
# 不在这里再写一遍，写两遍必然有一天不一致，而症状是后台印出一个打不开的地址、
# 服务本身却好着。
#
# 也正因为来源不同，两种模式的端口可以不一样：网关常驻占着 8443 时，独立模式
# 用 8720 不会撞。
XINGCHA_WEB_PORT=8720


# ═══════════════════════════════════════════════════════════════════════════
# 2 · 凭据（敏感项一律无默认值；空 = 没设置）
# ═══════════════════════════════════════════════════════════════════════════

# 后台密码。留空 = 第一次打开 /admin 时引导你设一个（推荐）。
#
# 填了就按它登录，任意长度都生效（太短会在启动日志里警告一次）。两件事要知道：
#   · 它会出现在 docker inspect 与 /proc/<pid>/environ 里；
#   · **先立者为准** —— 一旦你在页面上设过密码，这一项就永久不生效了。
XINGCHA_ADMIN_PASSWORD=

# 默认上游。不填就登录后到「上游」页配。
#
# BASE_URL 不填时回落到 OpenRouter。key 只在首次启动时被加密导入数据库，
# 之后永久忽略——所以配好之后建议从这里删掉。
XINGCHA_API_KEY=
XINGCHA_BASE_URL=

# 各厂商的 key（可选，写几个都行）。后台「上游」页会扫出来，一键切换。
# 内置名单 30 个，大小写不敏感。写完要重启——环境变量在进程启动时读取。
#
# DEEPSEEK_API_KEY=
# DASHSCOPE_API_KEY=
# MOONSHOT_API_KEY=
# GEMINI_API_KEY=
# OPENAI_API_KEY=


# ═══════════════════════════════════════════════════════════════════════════
# 3 · 其它（都有能用的默认值，一般不动）
# ═══════════════════════════════════════════════════════════════════════════

XINGCHA_LOG_LEVEL=INFO

# 数据挂载点。默认 ../data（仓库根下的 data/）。
#
# **Windows 必须改成命名卷**：Docker Desktop 经 9p/virtiofs 把 Windows 目录挂进
# 虚拟机，那是网络文件系统，SQLite 的 WAL 在上面会静默降级——症状是零星的
# database is locked，只在并发写时出现，压不出来也难复现。
# XINGCHA_DATA_MOUNT=xingcha_data

# 更细的调参（并发上限、超时、限流、目录 TTL……）见 docs/CONTRACT.md。
# 它们都有默认值，写在这里也生效，但多数人不需要动。
