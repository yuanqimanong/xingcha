# 星槎部署配置
#
# 复制到**仓库根**（不是 deploy/ 下）：
#
#     cp deploy/.env.example .env
#
# 然后 ./deploy/linux/xc start。**一项都不改也能起来**——非敏感项都有默认值，
# key 与密码留空表示"登录后再加"。
#
# Windows 上双击 deploy\windows\xc.bat，它会替你生成这份 .env。**那条路径不走 docker**，
# 所以 GATEWAY / WEB_PORT / DATA_MOUNT 对它无效——那几项是给 compose 看的。
# Windows 要改的在**最后一节**。
#
# 例外是 XINGCHA_WEB_HOST：网关（deploy/edge）两条路都用它，那是证书上的名字。
#
# 下面按"多半要动 → 可能要动 → 几乎不动"排。


# ═══════════════════════════════════════════════════════════════════════════
# 1 · 怎么访问它
# ═══════════════════════════════════════════════════════════════════════════

# 前面有没有那个网关（deploy/edge/ 里的 Caddy 单文件）。**这是 http / https 的开关。**
#
#   留空    明文 HTTP，容器发布的那个端口就是入口
#   edge    入口是 https://<WEB_HOST>:8443；容器那个端口被强制**只绑 127.0.0.1**，
#           局域网上连不到，唯一进得来的就是本机那个 Caddy
#
# 值是**网关的名字**（就是 deploy/edge 这个目录），不是地址、也不是 docker 网络名
# ——网关是宿主上的一个进程，不是容器。deploy/linux/xc 读这一项决定叠不叠
# docker-compose.gateway.yml，并且**只在配了它时才检查网关在不在**。
#
# 网关怎么起（下载一个可执行文件，然后 ./deploy/edge/edge start）：deploy/CADDY.md
# 没装 docker 的机器用同一个网关，要放开的是第 4 节。
XINGCHA_GATEWAY=

# 你在浏览器里敲的主机名或 IP。**三个地方都用它**：后台里展示的地址、网关签证书
# 用的名字（deploy/edge 的两个脚本从这里读）、以及不挂网关时绑在哪个接口上：
#
#   localhost / 127.0.0.1   只绑回环，只有这台机器能访问（默认，安全的那一档）
#   其它（IP 或域名）         绑 0.0.0.0，局域网可访问
#
# 合成一个变量，是因为分成两个最容易出的错是二者对不上：显示 192.168.1.10、
# 却只绑了回环，于是别人打不开而页面上的地址看起来完全正确。
#
# **挂了网关时它不再影响绑定**：那时一律绑 127.0.0.1（见 deploy/linux/xc 的
# derive_bind_addr），因为入口只该有网关那一个。
#
# **不要填 0.0.0.0** —— 那是"绑在所有接口上"的意思，不是能敲的名字。填了的话后台
# 会印出一条 http://0.0.0.0:8720/v1 的命令，照着敲必然失败。
#
# 开给局域网这件事本身要想清楚：映射出去的端口走 Docker 的 DOCKER-USER 链，
# **会绕过 ufw**。
XINGCHA_WEB_HOST=localhost

# 端口，**只在不走网关时用**。
#
# 挂网关时这仍然是**容器发布的那个端口**（只绑 127.0.0.1，网关从那里取数据），
# 但你在浏览器里敲的是网关的 8443——那个数字写在 deploy/edge/Caddyfile 里，
# deploy/linux/xc 自己知道，不在这里再写一遍：写两遍必然有一天不一致，而症状是
# 后台印出一个打不开的地址、服务本身却好着。
XINGCHA_WEB_PORT=8720


# ═══════════════════════════════════════════════════════════════════════════
# 2 · 凭据（敏感项一律无默认值；空 = 没设置）
# ═══════════════════════════════════════════════════════════════════════════

# 后台密码。留空 = 第一次打开 /admin 时引导你设一个（推荐）。
#
# 填了就按它登录，任意长度都生效（太短会在启动日志里警告一次）。两件事要知道：
#   · 它会出现在 docker inspect 与 /proc/<pid>/environ 里；
#   · **先立者为准** —— 一旦你在页面上设过密码，这一项就永久不生效了。
XINGCHA_ADMIN_PASSWORD=

# 默认上游。不填就登录后到「上游」页配。
#
# BASE_URL 不填时回落到 OpenRouter。key 只在首次启动时被加密导入数据库，
# 之后永久忽略——所以配好之后建议从这里删掉。
XINGCHA_API_KEY=
XINGCHA_BASE_URL=

# 各厂商的 key（可选，写几个都行）。后台「上游」页会扫出来，一键切换。
# 内置名单 30 个，大小写不敏感。写完要重启——环境变量在进程启动时读取。
#
# DEEPSEEK_API_KEY=
# DASHSCOPE_API_KEY=
# MOONSHOT_API_KEY=
# GEMINI_API_KEY=
# OPENAI_API_KEY=


# ═══════════════════════════════════════════════════════════════════════════
# 3 · 其它（都有能用的默认值，一般不动）
# ═══════════════════════════════════════════════════════════════════════════

XINGCHA_LOG_LEVEL=INFO

# 数据挂载点。默认 ../data（仓库根下的 data/），填卷名则改用命名卷。
#
# 只有在宿主目录不适合放 SQLite 时才动它——网络文件系统上 WAL 会静默降级，
# 症状是零星的 database is locked，只在并发写时出现。**本地磁盘不要改。**
# XINGCHA_DATA_MOUNT=xingcha_data

# 更细的调参（并发上限、超时、限流、目录 TTL……）见 docs/CONTRACT.md。
# 它们都有默认值，写在这里也生效，但多数人不需要动。


# ═══════════════════════════════════════════════════════════════════════════
# 4 · 不走 docker 的那条路（Windows 双击 deploy\windows\xc.bat；Linux 上 uv 直接跑）
# ═══════════════════════════════════════════════════════════════════════════
#
# 这一节和上面几节的性质**不一样**：上面那些是编排层的变量，compose 读了再决定
# 容器怎么起；这几项是**应用自己的设置**，被直接读进进程。
#
# 所以它们留在这份共用模板里不会伤到 docker 那条路——compose 的 `environment:`
# 排在 `env_file:` 之后，会把它们整个覆盖掉。一份模板同时服务两条路径靠的就是
# 这一点，不用维护第二份 .env.example（两份必然漂移，而症状是"我在 Windows 上
# 跑的那套和 Linux 上不是一个东西"）。
#
# **一项都不放开也能起**：127.0.0.1:8720，明文 HTTP，只有这台机器能打开。
# 要 HTTPS 就起同一个网关——deploy\edge\edge.bat（Windows 双击）或
# ./deploy/edge/edge start（Linux），它反代的正是 127.0.0.1:8720——然后放开下面两项。
#
# 这条路上没有 XINGCHA_GATEWAY 那个开关（那是给 compose 看的），所以这两项要手写。

# 绑哪个地址、哪个端口。默认 127.0.0.1:8720。
#
# **Caddy 单文件就在同一台机器上，所以这里不要改成 0.0.0.0**：走回环就够了，
# 而开在局域网上等于多一条绕过 TLS 的明文入口，谁都能直连。
# XINGCHA_HOST=127.0.0.1
# XINGCHA_PORT=8720

# 后台里展示的 curl 示例用它，填**你在浏览器里敲的那个地址**（本机内网 IP + 8443）。
#
# 不填的话页面上印的是 http://127.0.0.1:8720——用户复制那条命令拿到别的机器上
# 必然连不上，而错误信息指不到"该走网关"。
# XINGCHA_PUBLIC_URL=https://192.168.1.10:8443

# 信任谁发来的 X-Forwarded-*。不设的话应用看到的 scheme 是 http，
# **会话 cookie 不带 Secure**——浏览器那半段明明是 HTTPS，却少了一层保护，
# 而功能完全正常，没人会注意到。
#
# 填 127.0.0.1 就够了，Caddy 是本机进程、从回环连过来。**不要填 `*`**——
# docker 那条路敢填 `*` 的前提是容器零宿主端口、唯一入口就是网关，这里不成立。
# XINGCHA_TRUSTED_PROXIES=127.0.0.1
