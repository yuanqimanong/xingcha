# 星槎部署配置
#
# 复制到**仓库根**（不是 deploy/ 下）：
#
#     cp deploy/.env.example .env
#
# 然后 ./deploy/linux/xc start。**一项都不改也能起来**——非敏感项都有默认值，
# key 与密码留空表示"登录后再加"。
#
# Windows 上双击 deploy\windows\xc.bat，它会替你生成这份 .env。**那条路径不走 docker**，
# 所以第 1 节整节（GATEWAY / WEB_HOST / WEB_PORT）与 DATA_MOUNT 对它都无效——
# 那些是给 compose 看的。Windows 要改的在**最后一节**。
#
# 下面按"多半要动 → 可能要动 → 几乎不动"排。


# ═══════════════════════════════════════════════════════════════════════════
# 1 · 怎么访问它
# ═══════════════════════════════════════════════════════════════════════════

# 走不走共享网关（那台 Caddy）。**这是 http / https 的开关。**
#
#   留空    明文 HTTP，这个容器自己发布端口
#   edge    加入那个 docker 网络，零宿主端口，对外 HTTPS 由网关提供
#
# 值是 **docker 网络名**，不是地址。网关是一个独立项目（与 xingcha 平行的 edge/），
# 一台 Caddy 可以同时服务本机多个项目——根证书在每台设备只装一次。
# 怎么起、怎么装根证书：deploy/CADDY.md
XINGCHA_GATEWAY=

# 你在浏览器里敲的主机名或 IP。**它同时决定绑在哪个接口上**：
#
#   localhost / 127.0.0.1   只绑回环，只有这台机器能访问（默认，安全的那一档）
#   其它（IP 或域名）         绑 0.0.0.0，局域网可访问
#
# 合成一个变量，是因为分成两个最容易出的错是二者对不上：显示 192.168.1.10、
# 却只绑了回环，于是别人打不开而页面上的地址看起来完全正确。
#
# **不要填 0.0.0.0** —— 那是"绑在所有接口上"的意思，不是能敲的名字。填了的话后台
# 会印出一条 http://0.0.0.0:8720/v1 的命令，照着敲必然失败。
#
# 开给局域网这件事本身要想清楚：映射出去的端口走 Docker 的 DOCKER-USER 链，
# **会绕过 ufw**。
XINGCHA_WEB_HOST=localhost

# 端口，**只在不走网关时用**。
#
# 走网关时端口是网关的，源头在 edge/.env 的 PORT_XINGCHA，deploy/linux/xc 去那儿读——
# 不在这里再写一遍，写两遍必然有一天不一致，而症状是后台印出一个打不开的地址、
# 服务本身却好着。
#
# 也正因为来源不同，两种模式的端口可以不一样：网关常驻占着 8443 时，独立模式
# 用 8720 不会撞。
XINGCHA_WEB_PORT=8720


# ═══════════════════════════════════════════════════════════════════════════
# 2 · 凭据（敏感项一律无默认值；空 = 没设置）
# ═══════════════════════════════════════════════════════════════════════════

# 后台密码。留空 = 第一次打开 /admin 时引导你设一个（推荐）。
#
# 填了就按它登录，任意长度都生效（太短会在启动日志里警告一次）。两件事要知道：
#   · 它会出现在 docker inspect 与 /proc/<pid>/environ 里；
#   · **先立者为准** —— 一旦你在页面上设过密码，这一项就永久不生效了。
XINGCHA_ADMIN_PASSWORD=

# 默认上游。不填就登录后到「上游」页配。
#
# BASE_URL 不填时回落到 OpenRouter。key 只在首次启动时被加密导入数据库，
# 之后永久忽略——所以配好之后建议从这里删掉。
XINGCHA_API_KEY=
XINGCHA_BASE_URL=

# 各厂商的 key（可选，写几个都行）。后台「上游」页会扫出来，一键切换。
# 内置名单 30 个，大小写不敏感。写完要重启——环境变量在进程启动时读取。
#
# DEEPSEEK_API_KEY=
# DASHSCOPE_API_KEY=
# MOONSHOT_API_KEY=
# GEMINI_API_KEY=
# OPENAI_API_KEY=


# ═══════════════════════════════════════════════════════════════════════════
# 3 · 其它（都有能用的默认值，一般不动）
# ═══════════════════════════════════════════════════════════════════════════

XINGCHA_LOG_LEVEL=INFO

# 数据挂载点。默认 ../data（仓库根下的 data/），填卷名则改用命名卷。
#
# 只有在宿主目录不适合放 SQLite 时才动它——网络文件系统上 WAL 会静默降级，
# 症状是零星的 database is locked，只在并发写时出现。**本地磁盘不要改。**
# XINGCHA_DATA_MOUNT=xingcha_data

# 更细的调参（并发上限、超时、限流、目录 TTL……）见 docs/CONTRACT.md。
# 它们都有默认值，写在这里也生效，但多数人不需要动。


# ═══════════════════════════════════════════════════════════════════════════
# 4 · Windows 本地直跑（deploy\windows\xc.bat）——不走 docker 的那条路
# ═══════════════════════════════════════════════════════════════════════════
#
# 这一节和上面几节的性质**不一样**：上面那些是编排层的变量，compose 读了再决定
# 容器怎么起；这四项是**应用自己的设置**，被直接读进进程。
#
# 所以它们留在这份共用模板里不会伤到 Linux——compose 的 `environment:` 排在
# `env_file:` 之后，这四项一个不剩全被覆盖掉。一份模板同时服务两条路径靠的就是
# 这一点，不用维护第二份 .env.example（两份必然漂移，而症状是"我在 Windows 上
# 跑的那套和 Linux 上不是一个东西"）。

# 绑哪个地址。默认 127.0.0.1，只有这台机器能打开。
#
# **要让 Linux 那台 Caddy 反代过来就必须填 0.0.0.0**——docker 网络不跨主机，
# 网关只能按「IP:端口」找过来，而回环上它找不到。不填的症状是网关一直 502
# 而这台机器自己完全正常，两边单独看都没毛病。
#
# 填了之后端口是真的开在局域网上的：Windows 防火墙会弹一次窗，要放行、勾「专用网络」。
# XINGCHA_HOST=0.0.0.0
# XINGCHA_PORT=8720

# 后台里展示的 curl 示例用它，填**网关**的地址（Linux 那台的 IP，加 edge/.env 里
# 分给 xingcha 的 PORT_XINGCHA）。
#
# 不填的话页面上印的是 http://127.0.0.1:8720——用户复制那条命令拿到别的机器上
# 必然连不上，而错误信息指不到"该走网关"。
# XINGCHA_PUBLIC_URL=https://192.168.1.10:8443

# 信任谁发来的 X-Forwarded-*。不设的话应用看到的 scheme 是 http，
# **会话 cookie 不带 Secure**——浏览器那半段明明是 HTTPS，却少了一层保护，
# 而功能完全正常，没人会注意到。
#
# 填**那台 Linux 的内网 IP**，不要填 `*`。docker 那条路径敢填 `*` 的前提是容器
# 零宿主端口、唯一入口就是网关；这里不成立——端口开在局域网上谁都能连，
# 填 `*` 等于让任何人伪造 X-Forwarded-Proto。
# XINGCHA_TRUSTED_PROXIES=192.168.1.10
